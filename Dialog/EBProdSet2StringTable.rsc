	[
		{ String _name = "EBApothecary";							String _text = "Apothecary"; }
		{ String _name = "EBApothecaryLwr";							String _text = "apothecary"; }
		{ String _name = "EBApothecaryTip";							String _text = "Arrr, the Apothecary brews up Healin' Goods from Roots, Herbs, Wine, Seed Oil, Water, and Glassware. Up to 2 Apothecaries can be put to work to produce 3 to 4 Healing Broth, Healing Oil or Herbal Tea. Build Cycle: 60."; }
		
		{ String _name = "EBHerbalist";								String _text = "Herbalist"; }
		{ String _name = "EBHerbalistLwr";							String _text = "herbalist"; }
		{ String _name = "EBHerbalistTip";							String _text = "The Herbalist be used to gather herbs and provide simple health and healin' fer yer folk. Up to 2 Herbalists can be put to work to gather 2 to 3 Herbs. Build Cycle: 42."; }
		
		{ String _name = "EBGlassWorks";							String _text = "Glass Works";	}
		{ String _name = "EBGlassWorksLwr";							String _text = "glass works";	}
		{ String _name = "EBGlassWorksTip";							String _text = "The Glass Works turns Sand and Coal into Glass or Glassware. Up to 2 Glassmakers can be put to work to produce 7 to 8 Glass or 7 to 8 Glassware from 23 Sand + 3 Coal or 23 sand + 4 Industrial Coal. Build Cycles: 58."; }
		
		{ String _name = "EBWinery";								String _text = "Winery";	}
		{ String _name = "EBWineryLwr";								String _text = "winery";	}
		{ String _name = "EBWineryTip";								String _text = "Yo ho, the Winery turns Grape, Plum, or Cherry into fine Wine. 1 Vintner can be put to work to produce 7 to 10 Wine from either 45 Cherry, Grape, or Plum. Build Cycle: 72."; }
		
		{ String _name = "EBOilPress";								String _text = "Oil Press";	}
		{ String _name = "EBOilPressLwr";							String _text = "oil press";	}
		{ String _name = "EBOilPressTip";							String _text = "The Oil Press squeezes Vegetable Oil from Kernels, Seed Oil from Pecan or Walnut, and Linseed Oil from Flax. Up to 2 Pressers can be put to work to produce 18 to 24 Seed Oil from either Pecan or Walnut, produce 18 to 24 Vegetable Oil from 50 Kernels, or produce 18 to 24 Linseed Oil from 50 Flax. Build Cycles: 64."; }
		
		{ String _name = "EBShoreHut";								String _text = "Shore Hut";	}
		{ String _name = "EBShoreHutLwr";							String _text = "shore hut";	}
		{ String _name = "EBShoreHutTip";							String _text = "The Shore Hut gathers up Sand or Clay along the shore. Up to 2 Workers can be put to work to produce 5 to 7 Sand or 8 to 10 Clay. Build Cycles: 38."; }
		
		{ String _name = "CharcoalPile";							String _text = "Charburner"; }
		{ String _name = "CharcoalPileLwr";							String _text = "charburner"; }
		{ String _name = "CharcoalPileTip";							String _text = "The Char Burner turns firewood into Industrial Coal. 1 Worker can be put to work to produce 4 to 5 Industrial Coal from 4 Firewood. Build Cycles: 0."; }
		
		{ String _name = "ProfessionApothecary";					String _text = "Apothecary"; }
		{ String _name = "ProfessionApothecaryTip";					String _text = "The Apothecary brews up Healin' Goods."; }
		{ String _name = "ProfessionApothecaryDeath";				String _text = "went to Davy Jones' Locker after guzzlin' too much Herbal Tea."; }
		
		{ String _name = "ProfessionGlassmaker";					String _text = "Glassmaker"; }
		{ String _name = "ProfessionGlassmakerTip";					String _text = "The Glassmaker turns Sand and Coal into Glass and Glassware."; }
		{ String _name = "ProfessionGlassmakerDeath";				String _text = "bled out from a nasty run-in with broken glass, arrr."; }
		
		{ String _name = "ProfessionVintner";						String _text = "Vintner"; }
		{ String _name = "ProfessionVintnerTip";					String _text = "The Vintner turns Grape, Plum, or Cherry into Wine."; }
		{ String _name = "ProfessionVintnerDeath";					String _text = "Drank himself straight into Davy Jones' Locker."; }
		
		{ String _name = "ProfessionPresser";						String _text = "Presser"; }
