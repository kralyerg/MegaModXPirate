	//STARTING CONDITIONS

		{ String _name = "PalmsOnlyEasyName";		String _text = "Palm Trees - Easy"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "A standard Easy game with Palm trees only. An easy game begins with six families. A large amount of clothing, grub, firewood, building materials, and tools are provided. Homes and storage areas have already been built. Seeds for fields and orchards are available as well as a herd of livestock."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palm Trees - Medium"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "A standard Medium game with Palm trees only. A medium game begins with five families. Clothing, grub, firewood, tools, and construction materials, are provided. A storage barn has already been built. Some seeds for fields and orchards are available."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palm Trees - Hard"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "A standard Hard game with Palm trees only. A hard game begins with four families. A small amount of clothing, grub, firewood, and tools are provided. No seeds for farming are available."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palm Trees - Adam & Eve"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "A standard Adam & Eve game with Palm trees only. Start with just 2 crew. A small amount of grub, firewood and clothing is provided in a small storage cart. No structures have been built, no seeds or livestock are initially available - ye will have to survive and acquire everything."; }


