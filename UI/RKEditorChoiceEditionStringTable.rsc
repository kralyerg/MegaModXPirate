		{ String _name = "NMT3F1T1";			String _text = "MultiStory 1st floor"; }
		{ String _name = "NMT3F1T1Lwr";			String _text = "multistory 1st floor"; }
		{ String _name = "NMT3F1T1Tip";			String _text = "A NMT MultiStory house 1st floor be used for housing yer crew. Size: 4x5 tiles. Cost: 12 lumber, 24 stone, 2 iron, 8 glass, 12 logs. Residence: 5 crew. Heat EFF%: 92. Models: 6. Color: 1. Tips: Arrr, leave a space to the right and to the left for additional level stories. Press F to change models."; }

