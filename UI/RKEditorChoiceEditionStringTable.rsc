		{ String _name = "OrchardLodgeDateTreeTip";		String _text = "Used to define an area to selectively cut down trees and plant new date trees seedlings. Size: 5x6. Cost: 32 logs, 12 stone. Radius: 24 tiles. Employment: 1-2 foresters. Tips: Shiver me timbers, everything will be scuttled and replaced by a date tree which will spawn buckets of dates over time. It be like an orchard but set up like a forester lodge."; }

		{ String _name = "OrchardLodgeGrapefruitTree";		String _text = "Grapefruit Lodge"; }
		{ String _name = "OrchardLodgeGrapefruitTreeLwr";	String _text = "grapefruit lodge"; }
		{ String _name = "OrchardLodgeGrapefruitTreeTip";	String _text = "Used to define an area to selectively cut down trees and plant new grapefruit trees seedlings. Size: 5x6. Cost: 32 logs, 12 stone. Radius: 24 tiles. Employment: 1-2 foresters. Tips: Arrr, everything will be scuttled and replaced by a grapefruit tree which will spawn buckets of grapefruits over time. It be like an orchard but set up like a forester lodge."; }



		{ String _name = "NMT20AleStand";			String _text = "Ale Stand"; }
		{ String _name = "NMT20AleStandLwr";			String _text = "ale stand"; }
		{ String _name = "NMT20AleStandTip";			String _text = "Ale Stand be taking all yer alcohols and offer those to yer crew. Size: 4x3. Cost: 16 logs. Capacity: 3000 weight. Radius: 20 tiles. Employment: 1-2 brewers. Tips: Avast, the brewers will go around and grab all alcohols in the town and fill their stand. Crew can pickup alcohols and get (0.05%) happiness from it."; }

		{ String _name = "NMT30CharcoalKiln";			String _text = "Charcoal Kiln"; }
		{ String _name = "NMT30CharcoalKilnLwr";		String _text = "charcoal kiln"; }
		{ String _name = "NMT30CharcoalKilnTip";		String _text = "Charcoal Kiln be taking firewood and do charcoal with those. Size: 6x6. Cost: 12 logs, 32 stone. Can make: 18-24 charcoal from 12 firewood. Employment: 1-2 workers. Tips: Ahoy, double yer amount of fuel and provide enough fuel for double housing to compare with firewood."; }

		{ String _name = "NMT30FurnitureMaker";			String _text = "Furniture Maker"; }
		{ String _name = "NMT30FurnitureMakerLwr";		String _text = "furniture maker"; }
		{ String _name = "NMT30FurnitureMakerTip";		String _text = "Furniture Maker be taking lumber, wood, and some expensive metals and do nice furnitures. Size: 8x9. Cost: 34 logs, 48 lumber, 32 stones, 24 iron, 8 glass. Can make: furniture, fine furniture, silvered furniture, gilded furniture. Employment: 1-2 workers. Tips: Avast, makes some of the best endgame selling resources."; }

		{ String _name = "NMT30WeaponMaker";			String _text = "Weapon Maker"; }
		{ String _name = "NMT30WeaponMakerLwr";			String _text = "weapon maker"; }
		{ String _name = "NMT30WeaponMakerTip";			String _text = "Weapon Maker be taking iron, wood, and some expensive metal and do deadly weapons. Size: 7x9. Cost: 28 logs, 42 lumber, 38 stones, 36 iron, 4 glass. Can make: weapon, fine weapon, noble weapon, royal weapon. Employment: 1-2 toolmakers. Tips: Ahoy, makes some of the best endgame selling resources."; }

		{ String _name = "NMT30ArmorMaker";			String _text = "Armor Maker"; }
		{ String _name = "NMT30ArmorMakerLwr";			String _text = "armor maker"; }
		{ String _name = "NMT30ArmorMakerTip";			String _text = "Armor Maker be taking iron, wood, and some expensive metal and do sheilds and armor pieces. Size: 8x9. Cost: 32 logs, 40 lumber, 32 stones, 36 iron, 6 glass. Can make: shield, fine armor, noble armor, royal armor. Employment: 1-2 toolmakers. Tips: Yo ho, makes some of the best endgame selling resources."; }


		{ String _name = "ForesterLodge2";		String _text = "Forester Lodge 2"; }
		{ String _name = "ForesterLodge2Lwr";		String _text = "forester lodge 2"; }
		{ String _name = "ForesterLodge2Tip";		String _text = "Used to define an area to selectively cut down trees and plant new seedlings. This one will plant only the new set of trees. Size: 5x6. Cost: 32 logs, 12 stones. Radius: 30 tiles. Employment: 1-4 foresters. Yo ho ho!"; }

		{ String _name = "RKEBChapelwood";		String _text = "Little Wood Chapel"; }
		{ String _name = "RKEBChapelwoodLwr";		String _text = "little wood chapel"; }
		{ String _name = "RKEBChapelwoodTip";		String _text = "Provides happiness for the devout and a place to meet and worship. Size: 4x7. Cost: 24 logs, 54 lumber. Capacity: 100 Crewmate. Radius: 24 tiles. Employment: 1 cleric. Tips: Yo ho, Press F to change color."; }

		{ String _name = "RKEBChapelstone";		String _text = "Little Stone Chapel"; }
		{ String _name = "RKEBChapelstoneLwr";		String _text = "little stone chapel"; }
		{ String _name = "RKEBChapelstoneTip";		String _text = "Provides happiness for the devout and a place to meet and worship. Size: 4x7. Cost: 24 logs, 54 stone. Capacity: 100 Crewmate. Radius: 24 tiles. Employment: 1 cleric. Tips: Arrr, Press F to change color."; }


		{ String _name = "CountryLittleHouseToolbar";			String _text = "Country Little House 1 Toolbar"; }
		{ String _name = "CountryLittleHouseToolbarLwr";		String _text = "country little house 1 toolbar"; }
		{ String _name = "CountryLittleHouseToolbarTip";		String _text = "Country Little House 1 Toolbar. Open this toolbar to get Country Little House options. This be a set of 3 buildings: an house (center), a pantry (right), a stowage (left). Colors: 5 alternates!"; }

		{ String _name = "CountryLittleStock";			String _text = "Country Little Stockage"; }
		{ String _name = "CountryLittleStockLwr";		String _text = "country little stockage"; }
		{ String _name = "CountryLittleStockTip";		String _text = "Country Little Stockage can be use for a little stowage. Size: 2x4. Cost: 16 lumber. Capacity: 2000 weight. Accept: Fuel, Minerals, Tool, Herbs, Clothing, Textile, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc. Tips: Shiver me timbers, the stockage goes to the left of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleFood";			String _text = "Country Little Pantry"; }
		{ String _name = "CountryLittleFoodLwr";		String _text = "country little pantry"; }
		{ String _name = "CountryLittleFoodTip";		String _text = "Country Little Pantry can be use as extra grub stowage. Size: 2x3. Cost: 16 lumber. Capacity: 1600 weight. Accept: Edibles. Tips: Avast, the pantry goes to the right of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleStockB";			String _text = "Country Little Stockage"; }
		{ String _name = "CountryLittleStockBLwr";		String _text = "country little stockage"; }
		{ String _name = "CountryLittleStockBTip";		String _text = "Country Little Stockage can be use for a little stowage. Size: 2x4. Cost: 16 lumber. Capacity: 2000 weight. Accept: Fuel, Minerals, Tool, Herbs, Clothing, Textile, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc. Tips: Avast, the stockage goes to the left of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleFoodB";			String _text = "Country Little Pantry"; }
		{ String _name = "CountryLittleFoodBLwr";		String _text = "country little pantry"; }
		{ String _name = "CountryLittleFoodBTip";		String _text = "Country Little Pantry can be use as extra grub stowage. Size: 2x3. Cost: 16 lumber. Capacity: 1600 weight. Accept: Edibles. Tips: Yo ho, the pantry goes to the right of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleHouse";			String _text = "Country Little House"; }
		{ String _name = "CountryLittleHouseLwr";		String _text = "country little house"; }
		{ String _name = "CountryLittleHouseTip";		String _text = "Country Little House be housing yer country crew. Size: 4x5. Cost: 48 lumber. Residence: 6 crew. Heat EFF%: 90. Models: 1. Colors: 5 alternates. Tips: Ahoy, Press F to change color."; }

		{ String _name = "CountryLittleHouse2Toolbar";			String _text = "Country Little House 2 Toolbar"; }
		{ String _name = "CountryLittleHouse2ToolbarLwr";		String _text = "country little house 2 toolbar"; }
		{ String _name = "CountryLittleHouse2ToolbarTip";		String _text = "Avast, Country Little House 2 Toolbar. Open this toolbar to get Country Little House options. This be a set of 3 buildings: an house (center), a pantry (right), a stowage (left). Colors: 5 alternates."; }

		{ String _name = "CountryLittleStock2";			String _text = "Country Little Stockage"; }
		{ String _name = "CountryLittleStock2Lwr";		String _text = "country little stockage"; }
		{ String _name = "CountryLittleStock2Tip";		String _text = "Country Little Stockage can be use for a little stowage. Size: 2x4. Cost: 16 lumber. Capacity: 2000 weight. Accept: Fuel, Minerals, Tool, Health, Clothing, Textile, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc. Tips: Ahoy, the stockage goes to the left of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleFood2";			String _text = "Country Little Pantry"; }
		{ String _name = "CountryLittleFood2Lwr";		String _text = "country little pantry"; }
		{ String _name = "CountryLittleFood2Tip";		String _text = "Country Little Pantry can be use as extra grub stowage. Size: 2x3. Cost: 16 lumber. Capacity: 1600 weight. Accept: Edibles. Tips: Avast, the pantry goes to the right of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleStock2B";			String _text = "Country Little Stockage"; }
		{ String _name = "CountryLittleStock2BLwr";		String _text = "country little stockage"; }
		{ String _name = "CountryLittleStock2BTip";		String _text = "Country Little Stockage can be use for a little stowage. Size: 2x4. Cost: 16 lumber. Capacity: 2000 weight. Accept: Fuel, Minerals, Tool, Health, Clothing, Textile, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc. Tips: Arrr, the stockage goes to the left of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleFood2B";			String _text = "Country Little Pantry"; }
		{ String _name = "CountryLittleFood2BLwr";		String _text = "country little pantry"; }
		{ String _name = "CountryLittleFood2BTip";		String _text = "Country Little Pantry can be use as extra grub stowage. Size: 2x3. Cost: 16 lumber. Capacity: 1600 weight. Accept: Edibles. Tips: Arrr, the pantry goes to the right of the house and make sure to align those back walls. Press F to change color."; }

		{ String _name = "CountryLittleHouse2";			String _text = "Country Little House"; }
		{ String _name = "CountryLittleHouse2Lwr";		String _text = "country little house"; }
		{ String _name = "CountryLittleHouse2Tip";		String _text = "Country Little House be housing yer country crew. Size: 4x5. Cost: 48 lumber. Residence: 6 crew. Heat EFF%: 90. Models: 1. Colors: 5 alternates. Tips: Yo ho, Press F to change color."; }

		{ String _name = "PastureFenceless";			String _text = "Pasture Fenceless"; }
		{ String _name = "PastureFencelessLwr";			String _text = "pasture fenceless"; }
		{ String _name = "PastureFencelessTip";			String _text = "A Pasture Fenceless provides an area for livestock to graze. Size: from 7x7 to 30x30. Cost: 1 Fodder-Thatch per tile. Employment: 1-4 herdsmen. Tips: Yo ho, use R or T to rotate the pasture for making sure the animal shelter be closest to barns and in a mountain slope."; }

		{ String _name = "MarketMed";				String _text = "Market"; }
		{ String _name = "MarketMedLwr";			String _text = "market"; }
		{ String _name = "MarketMedTip";			String _text = "Used to provide a localized area for crew to collect grub, tools, and fuel. Size: 10x10. Cost: 32 lumber, 30 stone, 22 iron. Capacity: 12000 weight. Radius: 36 tiles. Stowage: Edible, Fuel, Tool, Health, Clothing. Employment: 1-8 vendors. Tips: Avast, one of the best to provide goods to crewmate homes. Smaller than big one."; }

		{ String _name = "RKFCLumbermill";			String _text = "Lumbermill"; }
		{ String _name = "RKFCLumbermillLwr";			String _text = "lumbermill"; }
		{ String _name = "RKFCLumbermillTip";			String _text = "Lumbermill be used to make Lumber from Logs. Size: 5x6. Cost: 48 logs, 6 stone. Can make : Lumber, firewood. Employment: 1-3 woodcutters. Tips: Ahoy, the Lumbermill be an early settlement building, all tier 2+ buildings will require lumber. It can also make firewood if needed. Press F for alternate roof colors."; }

		{ String _name = "RKFCForestBarn";			String _text = "Forest Barn"; }
		{ String _name = "RKFCForestBarnLwr";			String _text = "forest barn"; }
		{ String _name = "RKFCForestBarnTip";			String _text = "A Forest Barn can store everything that can come from forest outposts. Size: 5x6. Cost: 48 logs, 12 stone. Capacity: 12000 weight. Accept: Edibles, Tool, Health, Fuel, Wood, Textile, Grain, Vegetable, Fruit, Protein. Tips: Avast, mighty usefull to store simple goods coming from forest outposts."; }

		{ String _name = "TradingPostSeeds";			String _text = "TP Seed & Stock"; }
		{ String _name = "TradingPostSeedsLwr";			String _text = "tp seed & stock"; }
		{ String _name = "TradingPostSeedsTip";			String _text = "Allows for the trade of resources with only seeds/livestock merchants. Size: 8x11. Cost: 48 logs, 32 stone, 12 iron. Capacity: 30000 weight. Accept: Wood, Stone, Iron, Fuel, Tool, Textile, Clothing, Minerals, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc.  Employment: 1-10 traders. Tips: Avast, livestocks and Seeds merchants doesnt accept herbs and grub."; }

		{ String _name = "RKWoodBakery";				String _text = "Bakery"; }
		{ String _name = "RKWoodBakeryLwr";				String _text = "bakery"; }
		{ String _name = "RKWoodBakeryTip";				String _text = "Medieval bakery takes flour and makes bread, cakes and pies. Size: 5x6. Cost: 32 lumber, 16 stone, 24 charcoal, 6 glass. Can make: bread, cake, pies, quiche, omelette.  Employment: 1-2 bakers. Tips: Yo ho, grand for making tier 2 grub. Bakeries will take some various amount of grub, of flour and will try to give ye (+100% educated +50% uneducated) more grub overall. And some grub have more than 1 diet."; }

		{ String _name = "NMT30Windmill";				String _text = "Windmill"; }
		{ String _name = "NMT30WindmillLwr";				String _text = "windmill"; }
		{ String _name = "NMT30WindmillTip";				String _text = "Medieval windmill makes flour from grain. Size: 6x6. Cost: 48 lumber, 42 stone, 32 iron. Can make: flour from wheat, corn, barley, sorghum, oat, rye, rice. Employment: 1-2 millers. Tips: Avast, Press F for alternate models. They take 16 grains and make 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Watermill";				String _text = "Watermill"; }
		{ String _name = "NMT30WatermillLwr";				String _text = "watermill"; }
		{ String _name = "NMT30WatermillTip";				String _text = "Medieval watermill makes flour from grain. Size: 9x7. Cost: 48 lumber, 42 stone, 32 iron. Can make: flour from wheat, corn, barley, sorghum, oat, rye, rice. Employment: 1-3 millers. Tips: Arrr, this building require some water tiles. Work faster than windmill. They take 16 grains and make 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Apiary";					String _text = "Apiary"; }
		{ String _name = "NMT30ApiaryLwr";				String _text = "apiary"; }
		{ String _name = "NMT30ApiaryTip";				String _text = "Medieval Apiary be used to keep bees and generate honey and beewax. Size: 6x6. Cost: 16 logs, 24 fodder-thatch. Can make: honey (grub), beeswax (candles). Employment: 1-2 beekeepers. Tips: Arrr, this grub building provide early in the game, a mighty grand steady source of grub. Ye will also need it for beeswax to make candle to upgrade yer deplecated mines and quarries."; }

		{ String _name = "WoodButcher";					String _text = "Butcher"; }
		{ String _name = "WoodButcherLwr";				String _text = "butcher"; }
		{ String _name = "WoodButcherTip";				String _text = "Butcher cuts meats and makes tier 2 grub. Size: 4x6. Cost: 48 lumber, 42 stone, 32 iron. Can make: Tier 2 prepared meats (steaks roasts chops and poultries). Employment: 1-2 butchers. Tips: Yo ho, mighty grand building to take yer raw meats and raw poultry meats and process them to double yer protein quantities. From 12 meat ye get 18-24 steak (educated = +100%) (Uneducated = +50% only)."; }

		{ String _name = "NMT30LightHouse";				String _text = "LightHouse"; }
		{ String _name = "NMT30LightHouseLwr";				String _text = "lightHouse"; }
		{ String _name = "NMT30LightHouseTip";				String _text = "A LightHouse will offer town statistics and will attract nomads from far away. Size: 11x8. Cost: 58 lumber, 98 stone, 14 iron, 16 copper, 24 glass, 32 firewood. Employment: 1 fireworker. Tips: Arrr, the fireworker will take care of the fire at top so ye can attract nomads. The Lighthouse offer all the services a townhall can provide."; }

		{ String _name = "NMT30Watertower";				String _text = "Watertower"; }
		{ String _name = "NMT30WatertowerLwr";				String _text = "watertower"; }
		{ String _name = "NMT30WatertowerTip";				String _text = "A Watertower provide fresh water to yer crew. Size: 4x5. Cost: 34 logs, 8 iron. Can make: 12-15 water from the watertower.  Employment: 1-2 workers. Tips: Arrr, the water serves as grub but has no nutrients. Some buildings needs Water over time (like the greenhouses) as input."; }

		{ String _name = "NMT30Cathedral";				String _text = "Cathedral"; }
		{ String _name = "NMT30CathedralLwr";				String _text = "cathedral"; }
		{ String _name = "NMT30CathedralTip";				String _text = "The Medieval Cathedral provides happiness for the devout and a place to meet and worship. Size: 12x20. Cost: 90 lumber, 160 stone, 64 glass, 18 silver, 12 gold, 80 rooftile. Capacity 800 souls. Radius: 60 tiles. Employment: 1 cleric. Tips: Avast, many saves should have a magnificient Chathedral ! But not all of them."; }

		{ String _name = "NMT30SaltMine";				String _text = "Salt Mine"; }
		{ String _name = "NMT30SaltMineLwr";				String _text = "salt mine"; }
		{ String _name = "NMT30SaltMineTip";				String _text = "The Salt Mine be a working place that provides salt. Size: 6x6. Cost: 24 logs, 32 lumber, 12 iron. Can extract: 4-6 salt from the ground. Detraction: 20 tiles. Capacity 4000 Not renewable. Employment: 1-5 miners. Tips: Shiver me timbers, faster way to get salt. Salt be a mineral. When deplecated, destroy and build another one."; }

		{ String _name = "NMT30OldSmokery";				String _text = "Old Smokery"; }
		{ String _name = "NMT30OldSmokeryLwr";				String _text = "old smokery"; }
		{ String _name = "NMT30OldSmokeryTip";				String _text = "The Old Smokery be a working place which takes meats and smokes those for preservation. Size: 6x6. Cost: 18 lumber, 48 stone, 12 iron, 4 glass. Can make: Tier 2 prepared meats (smoked meats fish and poultries). Employment: 1-2 bakers. Tips: Ahoy, this building needs +1 firewood for each smoke process. But the output value stay at 3 (not 2). Fish at 2 value. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30OldSaltery";				String _text = "Old Saltery"; }
		{ String _name = "NMT30OldSalteryLwr";				String _text = "old saltery"; }
		{ String _name = "NMT30OldSalteryTip";				String _text = "The Old Saltery be a working place which takes meats and salts those for preservation. Size: 6x6. Cost: 36 lumber, 16 stone, 8 iron. Can make: Tier 2 prepared meats (cured meats fish and poultries). Employment: 1-2 bakers. Tips: Yo ho, this building needs +3 salt for each cured process. But the output value stay at 3 (not 2). Fish at 2 value. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30DryShack";				String _text = "Old Dry Shack"; }
		{ String _name = "NMT30DryShackLwr";				String _text = "old dry shack"; }
		{ String _name = "NMT30DryShackTip";				String _text = "The Old Dry Shack be a working place which takes meats and dries those for preservation. Size: 6x6. Cost: 28 lumber, 6 wood, 4 stone. Can make: Tier 2 prepared meats (dried meats fish and poultries). Employment: 1-2 bakers. Tips: Arrr, this building only needs meats. No other input but the value of the meats lost 1 value. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Creamery";				String _text = "Old Creamery"; }
		{ String _name = "NMT30CreameryLwr";				String _text = "old creamery"; }
		{ String _name = "NMT30CreameryTip";				String _text = "The Old Creamery be a working place which takes milk and make cheese, butter, cream and yogurt. Size: 8x8. Cost: 36 lumber, 24 stone, 8 glass, 6 iron. Can make: Tier 2 prepared meats (cheese butter cream yogurt). Employment: 1-2 dairymen. Tips: Yo ho, this building mainly needs milk. Ye can add some fruits. The outputs be variable due to the recipes. Education be important in the output numbers."; }

		{ String _name = "RKRedCreamery";				String _text = "Red Creamery"; }
		{ String _name = "RKRedCreameryLwr";				String _text = "red creamery"; }
		{ String _name = "RKRedCreameryTip";				String _text = "Red Creamery be a working place which takes milk and make cheese, butter, cream and yogurt. Size: 9x10. Cost: 68 lumber, 12 stone, 16 copper, 8 glass, 16 glassware. Can make: Tier 2 prepared meats (cheese butter cream yogurt). Employment: 1-3 dairymen. Tips: Shiver me timbers, this building mainly needs milk. Ye can add some fruits. The outputs be variable due to the recipes. Education be important in the output numbers. The red creamery be a lot faster than the old creamery."; }

		{ String _name = "NMT30MaltHouse";				String _text = "Malt House"; }
		{ String _name = "NMT30MaltHouseLwr";				String _text = "malt house"; }
		{ String _name = "NMT30MaltHouseTip";				String _text = "The Malt House be a working place which be taking grain and converting it into malt. Size: 6x8. Cost: 12 logs, 24 lumber, 48 stone, 24 brick, 8 iron, 12 glass. Can make: 18-24 Malt from 12 grain (barley corn oat rye sorghum wheat). Employment: 1-2 brewers. Tips: Ahoy, old ale has a value of 6 now. Beer has replaced Ale at 8 value but beer needs malt. So now, ye need to convert the grain into malt, and taverns will brew the malt."; }

		{ String _name = "NMT30Pond";					String _text = "Medieval Pond"; }
		{ String _name = "NMT30PondLwr";				String _text = "medieval pond"; }
		{ String _name = "NMT30PondTip";				String _text = "A Medieval Pond provides fish to yer crew. Size:8x9. Cost: 4 logs, 12 stone. Capacity: Unlimited. Tips: Ahoy, mighty independant from traditional fishing dock, the Pond will have an equivalent output. If ye decide to scuttle it, ye will need to use the flatten tool to get the ground back to normal."; }

		{ String _name = "StorageBarn";					String _text = "Stowage Barn"; }
		{ String _name = "StorageBarnLwr";				String _text = "stowage barn"; }
		{ String _name = "StorageBarnTip";				String _text = "Used to store goods such as grub, clothes, textiles, and tools. Size: 5x8. Cost: 48 logs, 16 stone. Capacity: 8000 weight. Accept: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tips: Shiver me timbers, make sure ye always have some barn space available to store yer grub and other things."; }

		{ String _name = "NMT30StorageBarnNorm";			String _text = "Normal Barn"; }
		{ String _name = "NMT30StorageBarnNormLwr";			String _text = "normal barn"; }
		{ String _name = "NMT30StorageBarnNormTip";			String _text = "A Normal Barn be used to store goods such as grub, clothes, textiles, and tools. Size: 5x8. Cost: 48 logs, 16 stone. Capacity: 10000 weight. Accept: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tips: Avast, this barn be the exact same one as inside the game stowage toolbar."; }

		{ String _name = "NMT30StorageBarnMed";				String _text = "Medium Barn"; }
		{ String _name = "NMT30StorageBarnMedLwr";			String _text = "medium barn"; }
		{ String _name = "NMT30StorageBarnMedTip";			String _text = "A Medium Barn be used to store goods such as grub, clothes, textiles, and tools. Size: 4x6. Cost: 32 logs, 12 stone. Capacity: 6000 weight. Accept: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tips: Avast, this barn be a smaller version of the regular barn. Cheaper and also medium size, it has a medium capacity."; }

		{ String _name = "NMT30StorageBarnSmall";			String _text = "Wee Barn"; }
		{ String _name = "NMT30StorageBarnSmallLwr";			String _text = "wee barn"; }
		{ String _name = "NMT30StorageBarnSmallTip";			String _text = "A Wee Barn be used to store goods such as grub, clothes, textiles, and tools. Size: 3x5. Cost: 24 logs, 8 stone. Capacity: 3800 weight. Accept: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tips: Yo ho, this barn be a smaller version of the medium barn. More cheaper and also wee size, it has a wee capacity."; }

		{ String _name = "NMT30StorageBarnTiny";			String _text = "Tiny Barn"; }
		{ String _name = "NMT30StorageBarnTinyLwr";			String _text = "tiny barn"; }
		{ String _name = "NMT30StorageBarnTinyTip";			String _text = "A Tiny Barn be used to store goods such as grub, clothes, textiles, and tools. Size: 2x3. Cost: 16 logs, 4 stone. Capacity: 1600 weight. Accept: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tips: Avast, this barn be a tiny version of the wee barn. A lot more cheaper and also tiny size, it has a tiny capacity."; }

		{ String _name = "NMT30Granary";				String _text = "Granary"; }
		{ String _name = "NMT30GranaryLwr";				String _text = "granary"; }
		{ String _name = "NMT30GranaryTip";				String _text = "A Granary be specialized stowage used to store only grub (edible and non-edible). Size: 5x8. Cost: 58 logs, 16 stone. Capacity: 12000 weight. Accept: Edibles, Grain, Vegetable, Fruit, Protein. Tips: Yo ho, this granary be a kind of barn but it only store grub (edible and non-edible) and has an higher capacity per tile. Cost a little bit more than regular barn."; }

		{ String _name = "NMT30RootCellar";				String _text = "Root Cellar"; }
		{ String _name = "NMT30RootCellarLwr";				String _text = "root cellar"; }
		{ String _name = "NMT30RootCellarTip";				String _text = "A Root Cellar be specialized underground stowage used to store only Fruit/Vegetable. Size: 4x5. Cost: 6 logs, 26 stone. Capacity: 8000 weight. Accept: Vegetable, Fruit. Tips: Ahoy, this root cellar be an underground kind of barn but it only store fruits and vegetables and has a lot higher capacity per tile. Cost more stones than logs."; }

		{ String _name = "RKmeatLocker";				String _text = "Meat Locker"; }
		{ String _name = "RKmeatLockerLwr";				String _text = "meat locker"; }
		{ String _name = "RKmeatLockerTip";				String _text = "A Meat Locker be specialized half-underground stowage used to store only Meat/Proteins. Size: 3x3 tiles. Cost: 5 logs, 12 stone. Capacity: 3600 weight. Accept: Protein. Tips: Ahoy, this meat locker be an half underground kind of barn but it only store meats and proteins and has a lot higher capacity per tile. Cost more stones than logs."; }

		{ String _name = "NMT30BarberShop";				String _text = "BarberShop"; }
		{ String _name = "NMT30BarberShopLwr";				String _text = "barbershop"; }
		{ String _name = "NMT30BarberShopTip";				String _text = "The BarberShop be a place held by a doctor who will help to keep yer crew healthy. Size: 4x5 tiles. Cost: 8 logs, 24 lumber, 32 stone, 8 glass, 12 perfum, 1 silver. Attendance: 10. Employment: 1 doctor. Tips: Arrr, this be a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design be made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30Dentist";				String _text = "Dentist"; }
		{ String _name = "NMT30DentistLwr";				String _text = "dentist"; }
		{ String _name = "NMT30DentistTip";				String _text = "The Dentist be a place held by a doctor who will help to keep yer crew healthy. Size: 4x5 tiles. Cost: 8 logs, 24 lumber, 32 stone, 8 glass, 6 copper, 1 gold. Attendance: 10. Employment: 1 doctor. Tips: Arrr, this be a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design be made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30Clinic";					String _text = "Clinic"; }
		{ String _name = "NMT30ClinicLwr";				String _text = "clinic"; }
		{ String _name = "NMT30ClinicTip";				String _text = "The Clinic be a place held by a doctor who will help to keep yer crew healthy. Size: 4x5 tiles. Cost: 8 logs, 24 lumber, 32 stone, 8 glass, 18 glassware, 24 herbs. Attendance: 20. Employment: 1 doctor. Tips: Ahoy, this be a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design be made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30BathHouse";				String _text = "Bath House"; }
		{ String _name = "NMT30BathHouseLwr";				String _text = "bath house"; }
		{ String _name = "NMT30BathHouseTip";				String _text = "The Bath House be an essential place for hygiene which help to keep yer crew healthy.  Size: 8x6 tiles. Cost: 24 lumber, 56 stone, 24 glass, 8 copper, 24 perfums, 36 herbs. Hapiness: Health. Radius: 60. Attendance: 200. Employment: 1 worker. Tips: Arrr, this be big building with a large radius. It provide hapiness: health and will attract idlers. The design be made to be to fit under Multi-level floors."; }

		{ String _name = "NMT30SchoolHouse";				String _text = "Medieval School"; }
		{ String _name = "NMT30SchoolHouseLwr";				String _text = "Medieval School"; }
		{ String _name = "NMT30SchoolHouseTip";				String _text = "The Medieval School be used to educate crew to be more productive. Size: 5x5 tiles. Cost: 48 lumber, 26 stone, 12 iron, 8 copper, 24 glass. Attendance: 40. Employment: 1 teacher. Tips: Yo ho, this be an education building with double students capacity to compare the regular school. Education be extremly essential in this mod. Non-Education increase largely the difficulty of the game."; }

		{ String _name = "RKShopHardware";				String _text = "Raw Materials"; }
		{ String _name = "RKShopHardwareLwr";				String _text = "raw materials"; }
		{ String _name = "RKShopHardwareTip";				String _text = "The Raw Materials Store be a little market that only sell raw materials (Wood, Minerals, Iron). Size: 4x5 tiles. Cost: 24 logs, 36 stone. Sell: (30%)Logs (40%)Minerals (30%)Iron. Capacity: 10000 weight. Employment: 1-6 vendors. Tips: Arrr, it Be a grand market to provide a blacksmith, a foundry, and any production building that use logs+iron and/or minerals. It fit under Multi-level floors."; }

		{ String _name = "RKShopBuilding";				String _text = "Building Materials"; }
		{ String _name = "RKShopBuildingLwr";				String _text = "building materials"; }
		{ String _name = "RKShopBuildingTip";				String _text = "The Building Materials Store be a little market that only sell Tier2 building materials (Stone, Construction: Lumber, Glass, Bricks, Rooftiles...). Size: 4x5 tiles. Cost: 24 logs, 36 stone. Sell: (20%)Stone (80%)Construction. Capacity: 10000 weight. Employment: 1-6 vendors. Tips: Ahoy, it Be a grand market to provide building materials to an area in developpement. It fit under Multi-level floors."; }

		{ String _name = "RKShopGrocery";				String _text = "Grocery Store"; }
		{ String _name = "RKShopGroceryLwr";				String _text = "grocery store"; }
		{ String _name = "RKShopGroceryTip";				String _text = "The Grocery Store be a little market that only sell grub (Proteins, Grain, Vegetables and Fruits). Size: 4x5 tiles. Cost: 24 logs, 36 stone. Sell: Grub (25%)Grain (25%)Fruit (25%)Vegetable (25%)Protein. Capacity: 10000 weight. Employment: 1-6 vendors. Tips: Avast, it Be a grand market to provide grub to a housing district. Will grab edible and non-edible grub. It fit under Multi-level floors."; }

		{ String _name = "RKShopDelicate";				String _text = "Supplies & Goods"; }
		{ String _name = "RKShopDelicateLwr";				String _text = "supplies & goods"; }
		{ String _name = "RKShopDelicateTip";				String _text = "The Supplies & Goods be a little market that only sell some various goods. Size: 4x5 tiles. Cost: 24 logs, 36 stone. Sell: (25%)Tool (25%)Fuel (25%)Clothing (25%)Health. Capacity: 10000 weight. Employment: 1-6 vendors. Tips: Arrr, it Be a grand market to provide everything else that be not grub to a housing district. Should provide everything else than grub for all yer housing. It fit under Multi-level floors."; }

		{ String _name = "RKShopFabrics";				String _text = "Fabrics & Co."; }
		{ String _name = "RKShopFabricsLwr";				String _text = "fabrics & co."; }
		{ String _name = "RKShopFabricsTip";				String _text = "The Fabrics & Co. be a little market that only sell fabrics materials to craft cloths (Textiles and Fabrics). Size: 4x5 tiles. Cost: 24 logs, 36 stone. Sell: (50%)Textile (50%)Fabric. Capacity: 10000 weight. Employment: 1-6 vendors. Tips: Arrr, it Be a grand market to provide tailors and everything that need textiles. It fit under Multi-level floors."; }

		{ String _name = "NewMedievalFlatTool";			String _text = "Flat Tool"; }
		{ String _name = "NewMedievalFlatToolLwr";		String _text = "flat tool"; }
		{ String _name = "NewMedievalFlatToolTip";		String _text = "Avast, Flat Tool serves to flat the ground back to normal after deleting a Canal piece, a Pond or an Open sky Mine... Also mighty helpful to raze hills too. It will lay orange X on the ground. Once the task be done, ye will need to use the Scuttle Building Tool to get rid of the orange X."; }

		{ String _name = "NMTMCsandpit";			String _text = "Sand pit"; }
		{ String _name = "NMTMCsandpitLWR";			String _text = "sand pit"; }
		{ String _name = "NMTMCsandpitTip";			String _text = "A Sand pit be a working area where ye can gather sand. Size: 9x9 tiles. Cost: 12 logs. Can Create: 6-9 Sand. Capacity: Unlimited. Employment: 1-6 stonecutters. Tips: Yo ho, it will create 6-9 sand per job done. Sand be a material with a value of 1. Take care to not block the entrance. Please allow a road in front."; }

		{ String _name = "NMTMCclaypit";			String _text = "Clay pit"; }
		{ String _name = "NMTMCclaypitLWR";			String _text = "clay pit"; }
		{ String _name = "NMTMCclaypitTip";			String _text = "A Clay pit be a working area where ye can gather clay. Size: 9x9 tiles. Cost: 12 logs. Can Create: 1-2 Clay. Capacity: Unlimited. Employment: 1-6 stonecutters. Tips: Arrr, it will create 1-2 clay per job done. Clay be a material with a value of 3. Take care to not block the entrance. Please allow a road in front."; }

		{ String _name = "NMTMCkiln";				String _text = "Kiln"; }
		{ String _name = "NMTMCkilnLWR";			String _text = "kiln"; }
		{ String _name = "NMTMCkilnTip";			String _text = "A kiln be a working area where ye can make bricks and rooftiles from clay. Size: 6x6 tiles. Cost: 26 stone. Can Make: 6-10 Brick(10 clay) or 6-10 Rooftile(10 clay). Employment: 1 worker. Tips: Ahoy, it also needs 2 firewood per job done. Bricks and rooftiles be construction items with a value of 5 each. A lot of buildings will require bricks and rooftiles as building material."; }

		{ String _name = "NMTMCglassmaker";			String _text = "Glass Maker"; }
		{ String _name = "NMTMCglassmakerLWR";			String _text = "glass maker"; }
		{ String _name = "NMTMCglassmakerTip";			String _text = "A Glass Maker be a working area where ye can make glass and glassware from sand. Size: 6x6 tiles. Cost: 38 logs, 32 stone, 12 iron. Can Make: 6-8 Glass(23 sand) or 6-9 Glassware(23 sand). Employment: 1 worker. Tips: Arrr, it also needs 6 firewood or 3 coal per job done. Glass be a construction item with a value of 8. Glassware be a crafted item with a value of 7. A lot of buildings will require glass as building material. Glassware be needed for production or building material."; }

		{ String _name = "NMT30MCironQuarry";			String _text = "Iron Quarry"; }
		{ String _name = "NMT30MCironQuarryLWR";		String _text = "iron quarry"; }
		{ String _name = "NMT30MCironQuarryTip";		String _text = "An Iron Quarry be a working area where ye can mine Iron or Copper. Size: 10x10 tiles. Cost: 48 logs. Can Create: 2-3 Iron Ore or 2-3 Copper Ore per work. Capacity: 2000. Employment: 1-6 miners. Tips: Ahoy, Iron Ore and Copper Ore be minerals with a value of 4. Ye will need a foundry to smelt these ores. (Blacksmiths can also help ye in wait ye have yer foundry). Once deplecated, ye can renew it 5 times."; }

		{ String _name = "NMT30MCrockQuarry";			String _text = "Rock Quarry"; }
		{ String _name = "NMT30MCrockQuarryLWR";		String _text = "rock quarry"; }
		{ String _name = "NMT30MCrockQuarryTip";		String _text = "An Rock Quarry be a working area where ye can mine Stone, Coal or Salt. Size: 10x10 tiles. Cost: 48 logs. Can Create: 1-2 Stone or 3-4 Coal or 4-6 Salt per work. Capacity: 2000. Employment: 1-6 miners. Tips: Avast, stone be stone limit with a value of 8. Coal be a mineral with a value of 4. And salt be a mineral with a value of 1. Once deplecated, ye can renew it 5 times."; }

		{ String _name = "NMT30MCrandomQuarry";			String _text = "Random Quarry"; }
		{ String _name = "NMT30MCrandomQuarryLWR";		String _text = "random quarry"; }
		{ String _name = "NMT30MCrandomQuarryTip";		String _text = "An Random Quarry be a working area where ye can mine everything... randomly. Size: 10x10 tiles. Cost: 48 logs. Can Create randomly: 1-2 Stone 3-4 Coal 4-6 Salt 2-3 IronOre 2-3 CopperOre per work. Capacity: 2000. Employment: 1-6 miners. Tips: Avast, stone has a value of 8. Coal, IronOre and CopperOre be minerals with a value of 4. And salt be a mineral with a value of 1. Once deplecated, ye can renew it 5 times. This random quarry can also give ye 1 Gem(value 200), 1-2 Silver Ores(value 11) and 1-2 Gold Ores(value 22). Those be also minerals."; }

		{ String _name = "NMT30MCironQuarryLvl2";		String _text = "Iron Quarry Lvl2"; }
		{ String _name = "NMT30MCironQuarryLvl2LWR";		String _text = "iron quarry lvl2"; }
		{ String _name = "NMT30MCironQuarryLvl2Tip";		String _text = "An Iron Quarry Lvl2 be a working area where ye can mine Iron or Copper!"; }

		{ String _name = "NMT30MCrockQuarryLvl2";		String _text = "Rock Quarry Lvl2"; }
		{ String _name = "NMT30MCrockQuarryLvl2LWR";		String _text = "rock quarry lvl2"; }
		{ String _name = "NMT30MCrockQuarryLvl2Tip";		String _text = "An Rock Quarry Lvl2 be a working area where ye can mine Stone, Coal or Salt!"; }

		{ String _name = "NMT30MCrandomQuarryLvl2";		String _text = "Random Quarry Lvl2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2LWR";		String _text = "random quarry lvl2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2Tip";		String _text = "An Random Quarry Lvl2 be a working area where ye can mine everything... randomly!"; }

		{ String _name = "NMT30MCironQuarryLvl3";		String _text = "Iron Quarry Lvl3"; }
		{ String _name = "NMT30MCironQuarryLvl3LWR";		String _text = "iron quarry lvl3"; }
		{ String _name = "NMT30MCironQuarryLvl3Tip";		String _text = "An Iron Quarry Lvl3 be a working area where ye can mine Iron or Copper. Arrr!"; }

		{ String _name = "NMT30MCrockQuarryLvl3";		String _text = "Rock Quarry Lvl3"; }
		{ String _name = "NMT30MCrockQuarryLvl3LWR";		String _text = "rock quarry lvl3"; }
		{ String _name = "NMT30MCrockQuarryLvl3Tip";		String _text = "Yo ho, an Rock Quarry Lvl3 be a working area where ye can mine Stone, Coal or Salt."; }

		{ String _name = "NMT30MCrandomQuarryLvl3";		String _text = "Random Quarry Lvl3"; }
		{ String _name = "NMT30MCrandomQuarryLvl3LWR";		String _text = "random quarry lvl3"; }
		{ String _name = "NMT30MCrandomQuarryLvl3Tip";		String _text = "Arrr, an Random Quarry Lvl3 be a working area where ye can mine everything... randomly."; }

		{ String _name = "NMT30MCironQuarryLvl4";		String _text = "Iron Quarry Lvl4"; }
		{ String _name = "NMT30MCironQuarryLvl4LWR";		String _text = "iron quarry lvl4"; }
		{ String _name = "NMT30MCironQuarryLvl4Tip";		String _text = "Arrr, an Iron Quarry Lvl4 be a working area where ye can mine Iron or Copper."; }

		{ String _name = "NMT30MCrockQuarryLvl4";		String _text = "Rock Quarry Lvl4"; }
		{ String _name = "NMT30MCrockQuarryLvl4LWR";		String _text = "rock quarry lvl4"; }
		{ String _name = "NMT30MCrockQuarryLvl4Tip";		String _text = "Arrr, an Rock Quarry Lvl4 be a working area where ye can mine Stone, Coal or Salt."; }

		{ String _name = "NMT30MCrandomQuarryLvl4";		String _text = "Random Quarry Lvl4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4LWR";		String _text = "random quarry lvl4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4Tip";		String _text = "An Random Quarry Lvl4 be a working area where ye can mine everything... randomly!"; }

		{ String _name = "NMT30MCironQuarryLvl5";		String _text = "Iron Quarry Lvl5"; }
		{ String _name = "NMT30MCironQuarryLvl5LWR";		String _text = "iron quarry lvl5"; }
		{ String _name = "NMT30MCironQuarryLvl5Tip";		String _text = "Shiver me timbers, an Iron Quarry Lvl5 be a working area where ye can mine Iron or Copper."; }

		{ String _name = "NMT30MCrockQuarryLvl5";		String _text = "Rock Quarry Lvl5"; }
		{ String _name = "NMT30MCrockQuarryLvl5LWR";		String _text = "rock quarry lvl5"; }
		{ String _name = "NMT30MCrockQuarryLvl5Tip";		String _text = "An Rock Quarry Lvl5 be a working area where ye can mine Stone, Coal or Salt. Avast!"; }

		{ String _name = "NMT30MCrandomQuarryLvl5";		String _text = "Random Quarry Lvl5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5LWR";		String _text = "random quarry lvl5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5Tip";		String _text = "An Random Quarry Lvl5 be a working area where ye can mine everything... randomly!"; }

		{ String _name = "NMT30Foundry";			String _text = "Foundry"; }
		{ String _name = "NMT30FoundryLWR";			String _text = "foundry"; }
		{ String _name = "NMT30FoundryTip";			String _text = "A Foundry be a working area where ye can smelt everything. Size: 8x8 tiles. Cost: 24 logs, 64 stone, 18 iron, 32 charcoal. Can Create: 1-2 iron, copper, silevr or gold per work. Employment: 1-2 blacksmiths. Tips: The Foundry be the way to go to smelt everything in the game and also be more efficient than the simple blacksmith buildings. "; }

		{ String _name = "NMT30JewelMaker";			String _text = "Jewelry Maker"; }
		{ String _name = "NMT30JewelMakerLWR";			String _text = "jewelry maker"; }
		{ String _name = "NMT30JewelMakerTip";			String _text = "A Jewelry Maker be taking precious metal and gems for crafting some mighty valuable rings, necklaces, and jewels. Size: 6x6 tiles. Cost: 8 logs, 24 lumber, 16 stone, 18 brick, 6 glass. Can make: jewelries from cutted gems and gold/silver, multiples recipes. Employment: 1 worker. Tips: Avast, ye need a gem cutter to cut those gems and once ye determined their value, ye can use those to make or a silvered or a golden version. Every recipes will drop more than just one item at time. Although, non-education be bad for this building. The list of recipes be too long to put it here."; }

		{ String _name = "NMT30GemCutter";			String _text = "Gem Cutter"; }
		{ String _name = "NMT30GemCutterLWR";			String _text = "gem cutter"; }
		{ String _name = "NMT30GemCutterTip";			String _text = "A Gem Cutter be taking gems, cut those, determine their quality and value. Size: 6x6 tiles. Cost: 8 logs, 24 lumber, 16 stone, 18 brick, 6 glass. Can make: amethyst(value 60) topaze(value 80) emerald(value 250) sapphire(value 300) ruby(value 400) diamond(value 1000). Employment: 1 worker. Tips: Yo ho, the only way to get uncut gems be from the random quarry. Of course, higher values be a lot more rare than common ones."; }

		{ String _name = "NMT30CandleMaker";			String _text = "Candle Maker"; }
		{ String _name = "NMT30CandleMakerLWR";			String _text = "candle maker"; }
		{ String _name = "NMT30CandleMakerTip";			String _text = "A Candle Maker be making Candles from Beeswax. Size: 6x6 tiles. Cost: 12 logs, 24 lumber, 18 stone, 24 brick, 12 glass. Can make: 3-4 candles from 16 beeswax per work. Employment: 1 worker. Tips: Avast, candle has a value of 8. Candles be used to upgrade and renew mines and quarries once they be deplecated."; }

		{ String _name = "NMT30MineUpgradeTip";			String _text = "Arrr, upgrade and renew this mine/quarry to another deeper level which will allow ye to still get resources from this mine even if deplecated. ye will need extra material like candles for this."; }

		{ String _name = "RKGardenWallsGreenHouse";			String _text = "GreenHouse"; }
		{ String _name = "RKGardenWallsGreenHouseLwr";			String _text = "greenhouse"; }
		{ String _name = "RKGardenWallsGreenHouseTip";			String _text = "A GreenHouse be the most powerful grub provider in this mod. Size: 5x7 tiles. Cost: 20 lumber, 20 stone, 48 glass. Can make: All kind of vegetables in game and some wee fruit plants, numbers created be variable from 16-24 to 20-28. Employment: 1 botanist. Tips: Ahoy, greenhouse need (2)fertilizer and (2)water over time per each job done. (best source of fertilizer be the stable, pastures with some animals will help a lot too. The water comes from a water well or water tower)."; }

		{ String _name = "RKGardenWallsStables";			String _text = "Stables"; }
		{ String _name = "RKGardenWallsStablesLwr";			String _text = "stables"; }
		{ String _name = "RKGardenWallsStablesTip";			String _text = "Stables be the best fertilizer provider in game. Size: 9x6 tiles. Cost: 20 lumber, 40 stone. Can create: 3-5 fertilizer(value 2) from 2 fodder-thatch and 2 water per job done. Employment: 1-2 stablemen. Tips: Yo ho, ye need a grand source of fodder-thatch which can come from clearing or from the fodder farmer and water from water well or water tower. Fertilizer be used in greenhouses(most powerful grub generator per tile)."; }

		{ String _name = "RKGardenWallsWell";				String _text = "Water Well"; }
		{ String _name = "RKGardenWallsWellLwr";			String _text = "water well"; }
		{ String _name = "RKGardenWallsWellTip";			String _text = "A Water Well be a grand source of fresh water. Size: 1x1 tiles(3x3 with roads). Cost: 4 lumber, 24 stone. Can make: 12-15 water(value 1) per job done. Employment: 1 worker. Tips: Shiver me timbers, this well CAN NOT be used for firefighting. It be producing water slower than the water tower. Water be a grub without nutrients(no diet flags) and be needed in many industries like stables, greenhouses, perfumery, apothecary..."; }

		{ String _name = "RKGardenWallsFodderFarmers";			String _text = "Fodder Farmers"; }
		{ String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "fodder farmers"; }
		{ String _name = "RKGardenWallsFodderFarmersTip";		String _text = "A Fodder Farmers will plant grass and harvest fodder-thatch when grass be fully grown (instead of trees). Size:5x6 tiles. Cost: 32 lumber, 4 stone. Can Make: 3-4 fodder-thatch per harvested grass patch. Radius: 26 tiles. Employment: 1-3 forester. Tips: Arrr, working exactly same as forester lodge but will plant grass. First they will have to clear everything in their radius, scuttle all trees and all ores will help them alot. and once scuttled, they will plant a grass patch. This grass needs to grow, and when mature, it will be harvested. Fodder can be used also to make firebundles(firewood)."; }

		{ String _name = "RKGardenWallsFlorist";			String _text = "Florist"; }
		{ String _name = "RKGardenWallsFloristLwr";			String _text = "florist"; }
		{ String _name = "RKGardenWallsFloristTip";			String _text = "A Florist will wander and try to gather flowers. Size: 5x6 tiles. Cost: 32 lumber, 4 stone. Can Make: 3-5 flowers per harvested flower patch. Radius: 32. Employment: 1 gatherer. Tips: Shiver me timbers, the florist will act exactly like a gatherer but it will search for flowers and seedlings. Not intended to be placed near forester/gatherer combo (mighty bad) but meant to be used in combo of the fodder farmer building. Grass will spawn tons of flowers. Warning: They will not plant flowers."; }

		{ String _name = "RKGardenWallsPerfumery";			String _text = "Perfumery"; }
		{ String _name = "RKGardenWallsPerfumeryLwr";			String _text = "perfumery"; }
		{ String _name = "RKGardenWallsPerfumeryTip";			String _text = "A Perfumery creates perfume from essence of flowers. Size: 5x5 tiles. Cost: 24 lumber, 24 stone, 8 copper, 12 glassware. Can Make: 5-8 perfumes (value 8) from 8 flower, 2 water, 1 glassware per job done. Employment: 1 worker. Tips: Arrr, one of the best items to sell that uses something we can find everywhere: flowers. This building requires water and glassware over time. Water comes from the water well or water tower and the glassware comes from the glass maker."; }

		{ String _name = "RKGardenWallsCustom5Barn";			String _text = "Fodder Barn"; }
		{ String _name = "RKGardenWallsCustom5BarnLwr";			String _text = "fodder barn"; }
		{ String _name = "RKGardenWallsCustom5BarnTip";			String _text = "This be a Fodder Barn that only allow fodder items and everything that fall into that category to be stored there. Size: 4x4 tiles. Cost: 12 logs, 28 fodder-thatch. Capacity: 6000 weight. Accept: Misc Items. Tips: Avast, fodder be Misc flag, so this be why it allows all Misc flag items. Allow alot more items to be stored in a 4x4 than a simple stockpile."; }

		{ String _name = "RKGardenWallsTrash";				String _text = "Trash"; }
		{ String _name = "RKGardenWallsTrashLwr";			String _text = "trash"; }
		{ String _name = "RKGardenWallsTrashTip";			String _text = "Shiver me timbers, trash this item and scuttle it."; }
		{ String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "Trash this item and scuttle it!"; }

		{ String _name = "OldBarnPub";				String _text = "Old Barn Pub"; }
		{ String _name = "OldBarnPubLWR";			String _text = "old barn pub"; }
		{ String _name = "OldBarnPubTip";			String _text = "An Old Barn Pub be a barn converted into a bar or pub. They will serve meals and drinking, and will have a festive ambience which will provide hapiness. Size: 6x6 tiles. Cost: 32 logs, 16 stone. Hapiness: Entertainment. Radius: 40 tiles. Employment: 1-3 brewers. Tips: Shiver me timbers, this building use a new flag: Consume. This special flag helps to deal with alcohol and will act the same. The brewers will take tier 2 meat, plus a vegetable and an alcohol and will make 12-16 meals (value  1). Crew will pickup meals and get hapiness back from it (exactly like ale) but cost alot less."; }


		{ String _name = "ClearWildFood";			String _text = "Collect Wild Grub"; }
		{ String _name = "ClearWildFoodLwr";			String _text = "collect wild grub"; }
		{ String _name = "ClearWildFoodTip";			String _text = "Collect and harvest wild grub spawns in the selected area. Tips: Yo ho, wild grub be spawning from trees and alot new grub be spawning from flowers."; }

		{ String _name = "ClearFodder";				String _text = "Collect Fodder"; }
		{ String _name = "ClearFodderLwr";			String _text = "collect fodder"; }
		{ String _name = "ClearFodderTip";			String _text = "Collect and harvest fodder-thatch patches in the selected area. Tips: Shiver me timbers, fodder-thatch be the material ye get from harvesting patches of grass ye can see on the ground. Fodder can be used in the stables, can be made into firebundles(firewood by woodcutters), can be used as building material(apiary, fenceless pasture, fodder barn...). each patch of grass creates 4-6 fodder-thatch (value 1). These be stored in a construction stockpile."; }

		{ String _name = "ClearFlower";				String _text = "Collect Flowers"; }
		{ String _name = "ClearFlowerLwr";			String _text = "collect flowers"; }
		{ String _name = "ClearFlowerTip";			String _text = "Collect and harvest flowers spawns in the selected area. Tips: Avast, flowers have the miscellaneous flag. Each patch of flowers create 3-5 flowers (value 1). Make sure ye have barns that accept miscellaneous items."; }

		{ String _name = "ClearHerb";				String _text = "Collect Herbs"; }
		{ String _name = "ClearHerbLwr";			String _text = "collect herbs"; }
		{ String _name = "ClearHerbTip";			String _text = "Collect and harvest herbs spawns in the selected area. Tips: Avast, herbs be used at an herbalist (or bathhouse) to get back 1/2 heart per used. Each patch of herbs create 2-3 herbs (value 4). Herbs require barn type of stowage."; }

		{ String _name = "ClearCopper";				String _text = "Collect Copper"; }
		{ String _name = "ClearCopperLwr";			String _text = "collect copper"; }
		{ String _name = "ClearCopperTip";			String _text = "Collect all copper and other rare minerals (gold and silver) in the selected area. Tips: Copper be used to make some tools and also as building materials. Copper and the other rare ores be minerals. Make sure ye have material stockpile available. 2-3 Copper ores be extracted (value 4), 1-2 silver ores (value 11) or 1-2 gold ores (value 22). Make sure ye have minerals stockpile available to store those. "; }

		{ String _name = "ClearAlmostAll";			String _text = "Collect Almost All"; }
		{ String _name = "ClearAlmostAllLwr";			String _text = "collect almost all"; }
		{ String _name = "ClearAlmostAllTip";			String _text = "Collect all ores and stones in the selected area. Tips: Shiver me timbers, this special tool will gather all ores and all stones. Will not scuttle the trees and grass and other valuable wild things. Mighty useful to clean up fast all the lands around foresters."; }

		{ String _name = "ClearFirewood";			String _text = "Collect Dead wood"; }
		{ String _name = "ClearFirewoodLwr";			String _text = "collect dead wood"; }
		{ String _name = "ClearFirewoodTip";			String _text = "Collect all dead wood in the selected area for firewood. Tips: Shiver me timbers, dead wood be dead trees fallen. Harvesting dead wood spawn will create 5-8 firewood per dead tree."; }

		{ String _name = "BostonHouse";				String _text = "Boston House"; }
		{ String _name = "BostonHouseLwr";			String _text = "boston house"; }
		{ String _name = "BostonHouseTip";			String _text = "Boston House. Every crewmate would love to live in a colorful Boston House. Size: 4x5 tiles. Cost: 54 lumber, 6 stone and 30 glass. Residence: 6 crew. Heat EFF%: 108. Models: 1. Colors: 8 alternates. Tips: Ahoy, Press F to change color."; }

		{ String _name = "BostonHouse2";			String _text = "Boston House 2"; }
		{ String _name = "BostonHouse2Lwr";			String _text = "boston house 2"; }
		{ String _name = "BostonHouse2Tip";			String _text = "Boston House 2 (different textures and models). Every crewmate would love to live in a colorful Boston House. Size: 4x5 tiles. Cost 54 lumber, 6 stone and 30 glass. Residence: 6 crew. Heat EFF%: 108. Models: 1. Colors: 10 alternates. Tips: Shiver me timbers, Press F to change color."; }

		{ String _name = "LittleHouseToolbar";			String _text = "Colorful Little House Toolbar"; }
		{ String _name = "LittleHouseToolbarLwr";		String _text = "colorful little house toolbar"; }
		{ String _name = "LittleHouseToolbarTip";		String _text = "Open this toolbar to get Colorful Little House options. Tips: Ahoy, this be a set that contains a first floor and a special 2nd floor to go on top of the first floor for a second family. They will have 5 occupants and an Heat EFF% of 80. 12 different colors. Press F to change color."; }

		{ String _name = "LittleHouse01";			String _text = "Colorful Little House"; }
		{ String _name = "LittleHouse01Lwr";			String _text = "colorful little house"; }
		{ String _name = "LittleHouse01Tip";			String _text = "A Colorful little house be used for housing yer crew. Size: 3x5 tiles. Cost: 24 logs, 6 stone. Residence: 5 crew. Heat EFF%: 80. Models: 1. Colors: 12 alternates. Tips: Ahoy, Press F to change color."; }

		{ String _name = "LittleHouse01floor2";			String _text = "Colorful Little House 2F"; }
		{ String _name = "LittleHouse01floor2Lwr";		String _text = "colorful little house 2f"; }
		{ String _name = "LittleHouse01floor2Tip";		String _text = "A Colorful 2nd floor be used for housing a 2nd family. Size: 1x5 tiles. Cost: 32 logs, 6 stone. Residence: 6 crew. Heat EFF%: 90. Models: 1. Colors: 12 alternates. Tips: Shiver me timbers, it goes to the right next the first floor, make sure ye align the chimneys in the back. it needs to perfectly fit on top of the 1st floor. Press F to change color."; }


		{ String _name = "NMT30MultiStoryHousingToolbar";			String _text = "NMT MultiLevel House Toolbar"; }
		{ String _name = "NMT30MultiStoryHousingToolbarLwr";			String _text = "nmt multilevel house toolbar"; }
		{ String _name = "NMT30MultiStoryHousingToolbarTip";			String _text = "NMT MultiLevel House Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Shiver me timbers, multiLevel be 3 story buildings. They be coming in different shapes, costs, textures but always same size: 1x5 + 4x5 + 1x5. The 2nd floor goes to the right of the 1st floor, the 3rd floor goes to the left of the 1st floor. They have 5-6 occupants capacity and have a range of Heat EFF% from 72 to 114."; }

		{ String _name = "NMT3Texture1";			String _text = "NMT MultiLevel Classic Stones Toolbar"; }
		{ String _name = "NMT3Texture1Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture1Tip";			String _text = "NMT MultiLevel Classic Stones Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Shiver me timbers, they will require lumber, stone, iron, glass and logs. Heat EFF% from 92 to 96."; }

		{ String _name = "NMT3Texture2";			String _text = "NMT MultiLevel Old Stones Toolbar"; }
		{ String _name = "NMT3Texture2Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture2Tip";			String _text = "NMT MultiLevel Old Stones Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Ahoy, they will require lumber, stone, iron, glass and logs. Heat EFF% from 92 to 96."; }

		{ String _name = "NMT3Texture3";			String _text = "NMT MultiLevel Red Bricks Toolbar"; }
		{ String _name = "NMT3Texture3Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture3Tip";			String _text = "NMT MultiLevel Red Bricks Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Ahoy, they will require lumber, brick, stone, glass and rooftile. Heat EFF% from 106 to 114."; }

		{ String _name = "NMT3Texture4";			String _text = "NMT MultiLevel Sand Bricks Toolbar"; }
		{ String _name = "NMT3Texture4Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture4Tip";			String _text = "NMT MultiLevel Sand Bricks Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Avast, they will require lumber, brick, stone, glass and rooftile. Heat EFF% from 106 to 114."; }

		{ String _name = "NMT3Texture5";			String _text = "NMT MultiLevel Fire Bricks Toolbar"; }
		{ String _name = "NMT3Texture5Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture5Tip";			String _text = "NMT MultiLevel Fire Bricks Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Ahoy, they will require lumber, brick, stone, glass and logs. Heat EFF% from 100 to 108."; }

		{ String _name = "NMT3Texture6";			String _text = "NMT MultiLevel Old Church Stones Toolbar"; }
		{ String _name = "NMT3Texture6Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture6Tip";			String _text = "NMT MultiLevel Old Church Stones Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Arrr, they will require lumber, stone, iron, glass and rooftile. Heat EFF% from 98 to 106."; }

		{ String _name = "NMT3Texture7";			String _text = "NMT MultiLevel Old Chapel Stones Toolbar"; }
		{ String _name = "NMT3Texture7Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture7Tip";			String _text = "NMT MultiLevel Old Chapel Stones Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Yo ho, they will require lumber, stone, iron, glass and rooftile. Heat EFF% from 98 to 106."; }

		{ String _name = "NMT3Texture8";			String _text = "NMT MultiLevel Old Wood Toolbar"; }
		{ String _name = "NMT3Texture8Lwr";			String _text = "nmt multilevel toolbar"; }
		{ String _name = "NMT3Texture8Tip";			String _text = "NMT MultiLevel Old Wood Toolbar. Open this toolbar to get NMT MultiLevel House options. Tips: Ahoy, they will require only lumber, logs, stone and glass. Heat EFF% from 72 to 80."; }

