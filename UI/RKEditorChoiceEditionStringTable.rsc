		{ String _name = "NMT3F2T1";			String _text = "MultiStory 2nd floor"; }
		{ String _name = "NMT3F2T1Lwr";			String _text = "multistory 2nd floor"; }
		{ String _name = "NMT3F2T1Tip";			String _text = "A NMT MultiStory house 2nd floor be used for housing yer crew. Size: 1x5 tiles. Cost: 16 lumber, 28 stone, 4 iron, 10 glass, 18 logs. Residence: 5 crew. Heat EFF%: 96. Models: 6. Color: 2. Tips: Shiver me timbers, they be meant to be placed just to the right of the Multi-level 1st floor. Press F to change models/colors."; }

