		{ String _name = "OrchardLodgeCoconutTree";		String _text = "Coconut Lodge"; }
		{ String _name = "OrchardLodgeCoconutTreeLwr";		String _text = "coconut lodge"; }
		{ String _name = "OrchardLodgeCoconutTreeTip";		String _text = "Used to define an area to selectively cut down trees and plant new coconut trees seedlings. Size: 5x6. Cost: 32 logs, 12 stone. Radius: 24 tiles. Employment: 1-2 foresters. Tips: Shiver me timbers, everything will be scuttled and replaced by a coconut tree which will spawn buckets of coconuts over time. It be like an orchard but set up like a forester lodge."; }

