StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "Arrr, Styth Towers - watchtowers for yer town. When staffed, they'll generate a random haul o' goods from confiscatin' stolen items from what we might only assume be bandits? or aliens...."; }
	
		{ String _name = "DSStythTower";					String _text = "Styth Tower"; }
		{ String _name = "DSStythTowerLwr";					String _text = "styth tower"; }
		{ String _name = "DSStythTowerTip";					String _text = "Shiver me timbers, the Styth Tower be the original Styth watchtower, generatin' a wee random haul o' items for the town (Alcohol,Tools,Clothing,Food,Etc) by riddin' the area of bandits - the town claims the spoils. Employs 1-2 Village Guards. Ye can only build 1 Styth Tower on a map."; }
		
		{ String _name = "DSNewStythTower";					String _text = "New Styth Tower"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "new styth tower"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "Arrr, the New Styth Tower be an updated Styth Tower, slightly larger in size. This watchtower generates a better haul o' random items for the town (Alcohol,Tools,Clothing,Food,Precious,Etc) by riddin' the area of bandits - the town claims the spoils. Employs 2-3 Village Guards. Ye can only build 1 New Styth Tower on a map."; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "Village Guard"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "Arrr, a Village Guard be employed to serve and protect the town. They be stationed at the Watchtowers. It be accepted that their mortality rate be higher than most other professions."; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "died of severe wounds, after defendin' the town from bandits."; }
		
		
		{ String _name = "Gold";			String _text = "Gold"; }
		{ String _name = "Silver";			String _text = "Silver"; }
		{ String _name = "Gems";			String _text = "Gems"; }
		
		{ String _name = "Lumber";			String _text = "Lumber"; }
	]
