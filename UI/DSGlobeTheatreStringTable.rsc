	Entry _strings
	[ 
		{ String _name = "DSGlobeTheatre";			String _text = "Globe Theatre"; }
		{ String _name = "DSGlobeTheatreLwr";		String _text = "globe theatre"; }
		{ String _name = "DSGlobeTheatreTip";		String _text = "Arrr, styled on Shakespeare's Globe Theatre. Employ Performers to work at the theatre, they will provide happiness to the crew and earn a wee amount of silver. Construction requires 610 work. Only one Globe Theatre can be built in a town."; }
		
		
		{ String _name = "EnableWorkDSGlobeTheatre";	String _text = "Theatre be performin'"; }
		{ String _name = "EnableWorkDSGlobeTheatreTip";	String _text = "Enable or disable use of this theatre."; }
		{ String _name = "DisableWorkDSGlobeTheatre";	String _text = "Theatre be closed"; }
		{ String _name = "workPlaceDSGlobeTheatreTxt";	String _text = "Aye, at the Globe Theatre, Performers entertain and provide happiness to the crew, gainin' a wee amount of Silver."; }
		
		{ String _name = "ProfessionPerformer";				String _text = "Performer"; }
		{ String _name = "ProfessionPerformerTip";			String _text = "A Performer works in buildings like Theatres, contributin' to the happiness of the crew."; }
		{ String _name = "ProfessionPerformerDeath";		String _text = "fell off the stage and died."; }
		
		{ String _name = "Silver";			String _text = "Silver"; }
